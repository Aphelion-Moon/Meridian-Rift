	saturated_head.receive_damage(brute = 40, wound_bonus = CANT_WOUND)
	TEST_ASSERT_EQUAL(saturated_head.get_damage(), saturated_cap, "Saturated head must keep limb damage capped.")
	var/saturated_pool_after = 0
	var/saturated_changed = 0
	for(var/slot in head_slots)
		var/slot_damage = saturated.get_organ_loss(slot)
		saturated_pool_after += slot_damage
		if(slot_damage != saturated_before[slot])
			saturated_changed += 1
	TEST_ASSERT_EQUAL(saturated_pool_after - saturated_pool_before, round(40 * MEDICAL_PAIN_OVERFLOW_HARD_SHARE, DAMAGE_PRECISION), "Saturated head must still overflow at the hard share.")
	TEST_ASSERT_EQUAL(saturated_changed, 1, "Saturated overflow must damage exactly one eligible organ.")
	REMOVE_TRAIT(saturated, TRAIT_NODEATH, TRAIT_SOURCE_UNIT_TESTS)
	REMOVE_TRAIT(saturated, TRAIT_NODISMEMBER, TRAIT_SOURCE_UNIT_TESTS)
	var/mob/living/carbon/human/mitigated = allocate(/mob/living/carbon/human/consistent)
	damage_chest_to_softcrit(mitigated)
	mitigated.get_bodypart(BODY_ZONE_HEAD).receive_damage(brute = 40, blocked = 50, wound_bonus = CANT_WOUND)
	var/mitigated_total = organ_pool_damage(mitigated, head_slots)
	TEST_ASSERT_EQUAL(mitigated_total, round(20 * MEDICAL_PAIN_OVERFLOW_SOFT_SHARE, DAMAGE_PRECISION), "Partial block must overflow from post-mitigation damage.")
	var/cancel_before = mitigated_total
	mitigated.get_bodypart(BODY_ZONE_HEAD).receive_damage(brute = 40, required_bodytype = BODYTYPE_ROBOTIC, wound_bonus = CANT_WOUND)
	var/cancel_after = organ_pool_damage(mitigated, head_slots)
	TEST_ASSERT_EQUAL(cancel_after - cancel_before, 0, "Bodytype-cancelled limb damage must not overflow.")
	var/mob/living/carbon/human/burn_share = allocate(/mob/living/carbon/human/consistent)
	damage_chest_to_softcrit(burn_share)
	burn_share.get_bodypart(BODY_ZONE_HEAD).receive_damage(burn = 40, wound_bonus = CANT_WOUND)
	var/burn_total = organ_pool_damage(burn_share, head_slots)
	TEST_ASSERT_EQUAL(burn_total, round(40 * MEDICAL_PAIN_OVERFLOW_SOFT_SHARE, DAMAGE_PRECISION), "Burn overflow must share the same post-mitigation pool as brute.")
	var/mob/living/carbon/human/relieved_share = allocate(/mob/living/carbon/human/consistent)
	damage_chest_to_softcrit(relieved_share)
	ADD_TRAIT(relieved_share, TRAIT_ANALGESIA, TRAIT_SOURCE_UNIT_TESTS)
	relieved_share.get_bodypart(BODY_ZONE_HEAD).receive_damage(brute = 40, wound_bonus = CANT_WOUND)
	var/relieved_total = organ_pool_damage(relieved_share, head_slots)
	TEST_ASSERT_EQUAL(relieved_total, round(40 * MEDICAL_PAIN_OVERFLOW_SOFT_SHARE, DAMAGE_PRECISION), "Overflow must ignore analgesia.")
	TEST_ASSERT_EQUAL(relieved_share.stat, STABLE, "Analgesia must defer despite overflow injury.")
	REMOVE_TRAIT(relieved_share, TRAIT_ANALGESIA, TRAIT_SOURCE_UNIT_TESTS)

// Ninety-percent pain must ramp 0 to 2 to 4 to 6 across gated life updates, then recover by hysteresis.
/datum/unit_test/medical_pain/proc/test_high_pain_ramp()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/chest = patient.get_bodypart(BODY_ZONE_CHEST)
	chest.receive_damage(brute = 150, wound_bonus = CANT_WOUND)
	var/datum/medical_pain/pain_state = patient.medical_pain
	pain_state.recalculate()
	TEST_ASSERT_EQUAL(pain_state.raw_pain, 180, "Scaled chest injury must sample at ninety percent.")
	TEST_ASSERT_EQUAL(pain_state.stage, 0, "Sampling without life processing must not advance stages.")
	var/simulation_time = world.time + 2 SECONDS
	pain_state.recalculate(advance_stage = TRUE, current_time = simulation_time)
	TEST_ASSERT_EQUAL(pain_state.stage, 2, "The first permitted update must reach stage two.")
	pain_state.recalculate(advance_stage = TRUE, current_time = simulation_time + 2 SECONDS)
	TEST_ASSERT_EQUAL(pain_state.stage, 4, "The second permitted update must reach stage four.")
	pain_state.recalculate(advance_stage = TRUE, current_time = simulation_time + 4 SECONDS)
	TEST_ASSERT_EQUAL(pain_state.stage, 6, "The third permitted update must reach stage six.")
	var/datum/movespeed_modifier/pain_modifier = patient.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown)
	TEST_ASSERT_NOTNULL(pain_modifier, "Overwhelming pain must apply movement impairment.")
	TEST_ASSERT_EQUAL(pain_modifier.multiplicative_slowdown, 3, "Overwhelming pain must use the increased slowdown, not stack with the hardcrit floor.")
	chest.heal_damage(20, 0)
	pain_state.recalculate()
	TEST_ASSERT_EQUAL(pain_state.stage, 6, "Seventy-eight-percent pain must hold stage six within hysteresis.")
	chest.heal_damage(15, 0)
	pain_state.recalculate()
	TEST_ASSERT_EQUAL(pain_state.stage, 5, "Pain below seventy-five percent must recover promptly to stage five.")
	TEST_ASSERT_EQUAL(pain_modifier.multiplicative_slowdown, 2.25, "Intense pain must use the increased movement slowdown.")

// Hardcrit-range health keeps a movement floor under analgesia; exemptions clear it.
/datum/unit_test/medical_pain/proc/test_hardcrit_floors()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	damage_chest_to_hardcrit(patient)
	TEST_ASSERT(patient.health <= patient.hardcrit_threshold, "Hardcrit fixture must reach hardcrit health.")
	patient.medical_pain.recalculate()
	var/datum/movespeed_modifier/floor_modifier = patient.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown)
	TEST_ASSERT_NOTNULL(floor_modifier, "Hardcrit health must apply the damage slowdown modifier.")
	TEST_ASSERT_EQUAL(floor_modifier.multiplicative_slowdown, MEDICAL_PAIN_HARDCRIT_SLOWDOWN, "Hardcrit health must floor movement impairment at 1.5.")
	ADD_TRAIT(patient, TRAIT_ANALGESIA, TRAIT_SOURCE_UNIT_TESTS)
	patient.medical_pain.recalculate()
	floor_modifier = patient.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown)
	TEST_ASSERT_NOTNULL(floor_modifier, "Trait relief must not remove the hardcrit-health floor.")
	TEST_ASSERT_EQUAL(floor_modifier.multiplicative_slowdown, MEDICAL_PAIN_HARDCRIT_SLOWDOWN, "Trait relief must not lower the hardcrit-health floor.")
	TEST_ASSERT(patient.defers_injury_crit(), "Pain relief must preserve control at hardcrit health.")
	patient.get_bodypart(BODY_ZONE_CHEST).heal_damage(10, 0)
	TEST_ASSERT(patient.health > patient.hardcrit_threshold, "Partial healing must leave hardcrit health.")
	TEST_ASSERT(!patient.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown), "The floor must clear above hardcrit health while pain is suppressed.")
	REMOVE_TRAIT(patient, TRAIT_ANALGESIA, TRAIT_SOURCE_UNIT_TESTS)
	var/mob/living/carbon/human/medicated = allocate(/mob/living/carbon/human/consistent)
	damage_chest_to_hardcrit(medicated)
	medicated.reagents.add_reagent(/datum/reagent/medicine/morphine, 10)
	var/datum/reagent/morphine = medicated.reagents.has_reagent(/datum/reagent/medicine/morphine)
	morphine.compute_metabolization(medicated, SSMOBS_DT)
	medicated.medical_pain.recalculate()
	floor_modifier = medicated.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown)
	TEST_ASSERT_NOTNULL(floor_modifier, "Finite relief must not remove the hardcrit-health floor.")
	TEST_ASSERT_EQUAL(floor_modifier.multiplicative_slowdown, MEDICAL_PAIN_HARDCRIT_SLOWDOWN, "Finite relief must not lower the hardcrit-health floor.")
	medicated.reagents.clear_reagents()
	patient.fully_heal(ADMIN_HEAL_ALL)
	TEST_ASSERT(!patient.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown), "Full healing must clear the hardcrit-health floor.")
	var/mob/living/carbon/human/stasis_patient = allocate(/mob/living/carbon/human/consistent)
	damage_chest_to_hardcrit(stasis_patient)
	ADD_TRAIT(stasis_patient, TRAIT_STASIS, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT(!stasis_patient.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown), "Stasis must clear the hardcrit-health floor.")
	REMOVE_TRAIT(stasis_patient, TRAIT_STASIS, TRAIT_SOURCE_UNIT_TESTS)
	var/mob/living/carbon/human/godmode_patient = allocate(/mob/living/carbon/human/consistent)
	damage_chest_to_hardcrit(godmode_patient)
	godmode_patient.medical_pain.recalculate()
	ADD_TRAIT(godmode_patient, TRAIT_GODMODE, TRAIT_SOURCE_UNIT_TESTS)
	godmode_patient.medical_pain.recalculate()
	TEST_ASSERT(!godmode_patient.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown), "Godmode must clear the hardcrit-health floor.")
	REMOVE_TRAIT(godmode_patient, TRAIT_GODMODE, TRAIT_SOURCE_UNIT_TESTS)
	var/mob/living/carbon/human/dying = allocate(/mob/living/carbon/human/consistent)
	damage_chest_to_hardcrit(dying)
	dying.medical_pain.recalculate()
	dying.death()
	TEST_ASSERT(!dying.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown), "Death must clear the hardcrit-health floor.")
	var/mob/living/carbon/human/synthetic = allocate(/mob/living/carbon/human/consistent)
	synthetic.set_species(/datum/species/android)
	damage_chest_to_hardcrit(synthetic)
	synthetic.medical_pain.recalculate()
	TEST_ASSERT(!synthetic.uses_medical_pain(), "Android fixture must opt out of medical pain.")
	var/datum/movespeed_modifier/synthetic_modifier = synthetic.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown)
	TEST_ASSERT_NOTNULL(synthetic_modifier, "Synthetic bodies must retain legacy damage impairment.")
	TEST_ASSERT_EQUAL(synthetic_modifier.multiplicative_slowdown, (synthetic.maxHealth - synthetic.health) / MEDICAL_PAIN_DAMAGE_SLOW_DIVISOR, "Synthetic bodies must use the legacy damage formula.")
