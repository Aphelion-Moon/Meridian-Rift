// Regression coverage for injury-derived pain, treatment, and independent symptom timing.
/datum/unit_test/medical_pain

// Exercise the medical paths without yielding to natural mob processing.
/datum/unit_test/medical_pain/Run()
	test_injury_healing()
	test_organs()
	test_fracture()
	test_analgesia()
	test_stage_timing()
	test_lifecycle()
	test_synthetic_bodies()
	test_crit_deferral()
	test_treatment_control()
	test_physiological_guards()
	test_organ_guards()
	test_unrelated_preservation()
	test_overflow_shares()
	test_overflow_guards()
	test_high_pain_ramp()
	test_hardcrit_floors()

// Stored limb damage heals directly; oxygen and exhaustion must not create pain.
/datum/unit_test/medical_pain/proc/test_injury_healing()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT_NOTNULL(patient.medical_pain, "Humans must initialize their medical pain state.")
	var/obj/item/bodypart/arm = patient.get_bodypart(BODY_ZONE_R_ARM)
	arm.receive_damage(brute = 20, burn = 10, wound_bonus = CANT_WOUND)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.medical_pain.raw_pain, 39, "Scaled brute and burns must contribute without armor being applied again.")
	arm.heal_damage(20, 10)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.medical_pain.raw_pain, 0, "Direct limb healing must remove its pain.")
	patient.adjust_oxy_loss(50)
	patient.adjust_stamina_loss(50)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.medical_pain.raw_pain, 0, "Oxygen damage and exhaustion must not become injury pain.")
	TEST_ASSERT(patient.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown), "Non-pain damage must retain movement impairment.")
	ADD_TRAIT(patient, TRAIT_ANALGESIA, TRAIT_SOURCE_UNIT_TESTS)
	patient.medical_pain.recalculate()
	TEST_ASSERT(patient.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown), "Pain immunity must not erase oxygen or stamina impairment.")

// Organ-only damage must be sampled independently of health and have an aggregate cap.
/datum/unit_test/medical_pain/proc/test_organs()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/organ/liver = patient.get_organ_slot(ORGAN_SLOT_LIVER)
	patient.set_organ_loss(ORGAN_SLOT_LIVER, liver.high_threshold)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.medical_pain.raw_pain, 20, "A damaged liver must hurt without limb injury.")
	patient.set_organ_loss(ORGAN_SLOT_LIVER, 0)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.medical_pain.raw_pain, 0, "Organ repair must remove its contribution.")
	for(var/organ_slot in list(ORGAN_SLOT_LIVER, ORGAN_SLOT_LUNGS, ORGAN_SLOT_STOMACH, ORGAN_SLOT_APPENDIX))
		var/obj/item/organ/damaged_organ = patient.get_organ_slot(organ_slot)
		patient.set_organ_loss(organ_slot, damaged_organ.high_threshold)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.medical_pain.raw_pain, 60, "Multiple organ injuries must respect the aggregate cap.")

// A fracture persists after brute healing and responds to actual limb dressing state.
/datum/unit_test/medical_pain/proc/test_fracture()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/arm = patient.get_bodypart(BODY_ZONE_R_ARM)
	var/datum/wound/blunt/bone/severe/fracture = new
	TEST_ASSERT(fracture.apply_wound(arm, silent = TRUE), "The fracture fixture must attach to its limb.")
	arm.heal_damage(INFINITY, INFINITY)
	patient.reagents.clear_reagents()
	patient.medical_pain.recalculate()
	var/untreated_pain = patient.medical_pain.raw_pain
	TEST_ASSERT(untreated_pain > 0, "An untreated fracture must hurt with healed brute damage.")
	var/obj/item/stack/medical/wrap/gauze/dressing = allocate(/obj/item/stack/medical/wrap/gauze)
	TEST_ASSERT(arm.apply_item(dressing, LIMB_ITEM_GAUZE), "The dressing fixture must attach.")
	patient.medical_pain.recalculate()
	TEST_ASSERT(patient.medical_pain.raw_pain < untreated_pain, "Splinting must reduce fracture pain without requiring new damage.")
	TEST_ASSERT(fracture in arm.wounds, "Symptom relief must not repair a fracture.")
	dressing.forceMove(run_loc_floor_bottom_left)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.medical_pain.raw_pain, untreated_pain, "Removing a splint must restore untreated fracture pain.")
	qdel(fracture)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.medical_pain.raw_pain, 0, "Removing the repaired wound must clear the persistent surcharge.")

// Relief follows active metabolism, uses the strongest source, and disappears on purge.
/datum/unit_test/medical_pain/proc/test_analgesia()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	patient.reagents.add_reagent(/datum/reagent/medicine/granibitaluri, 10)
	TEST_ASSERT_EQUAL(patient.get_medical_pain_relief(), 0, "An inactive reagent must not provide bloodstream relief.")
	var/datum/reagent/mild = patient.reagents.has_reagent(/datum/reagent/medicine/granibitaluri)
	mild.compute_metabolization(patient, SSMOBS_DT)
	TEST_ASSERT_EQUAL(patient.get_medical_pain_relief(), 25, "Active mild medicine must provide finite relief.")
	TEST_ASSERT(!patient.has_surgical_analgesia(), "Mild medicine must not provide surgical anesthesia.")
	patient.reagents.add_reagent(/datum/reagent/medicine/morphine, 10)
	var/datum/reagent/strong = patient.reagents.has_reagent(/datum/reagent/medicine/morphine)
	strong.compute_metabolization(patient, SSMOBS_DT)
	TEST_ASSERT_EQUAL(patient.get_medical_pain_relief(), 80, "Mixed analgesics must use the strongest source, not add strengths.")
	TEST_ASSERT(patient.has_surgical_analgesia(), "Morphine must retain surgical analgesia.")
	patient.reagents.remove_reagent(/datum/reagent/medicine/morphine, INFINITY)
	TEST_ASSERT_EQUAL(patient.get_medical_pain_relief(), 25, "Purging the strongest source must expose remaining mild relief.")
	patient.reagents.end_metabolization(patient, keep_liverless = FALSE)
	TEST_ASSERT_EQUAL(patient.get_medical_pain_relief(), 0, "Stopped metabolism must not retain analgesia.")
	patient.reagents.clear_reagents()
	TEST_ASSERT_EQUAL(patient.get_medical_pain_relief(), 0, "Purging all drugs must leave no stale relief.")

// Extra reads cannot accelerate stages, and recovery uses a separate threshold.
// Permitted life updates advance up to two stages; thresholds and hysteresis are unchanged.
/datum/unit_test/medical_pain/proc/test_stage_timing()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	patient.adjust_tox_loss(160)
	var/datum/medical_pain/pain_state = patient.medical_pain
	var/simulation_time = world.time + 2 SECONDS
	pain_state.recalculate(advance_stage = TRUE, current_time = simulation_time)
	TEST_ASSERT_EQUAL(pain_state.stage, 2, "An injury must escalate by up to two stages per interval.")
	pain_state.recalculate(advance_stage = TRUE, current_time = simulation_time)
	TEST_ASSERT_EQUAL(pain_state.stage, 2, "Repeated updates in the same interval must not escalate symptoms.")
	pain_state.recalculate(current_time = simulation_time + 2 SECONDS)
	TEST_ASSERT_EQUAL(pain_state.stage, 2, "A diagnostic refresh must not advance the stage.")
	pain_state.recalculate(advance_stage = TRUE, current_time = simulation_time + 2 SECONDS)
	pain_state.recalculate(advance_stage = TRUE, current_time = simulation_time + 4 SECONDS)
	TEST_ASSERT_EQUAL(pain_state.stage, 3, "Sustained forty-percent pain must reach stage three.")
	patient.adjust_tox_loss(-12)
	pain_state.recalculate()
	TEST_ASSERT_EQUAL(pain_state.stage, 3, "Thirty-seven-percent pain must stay within stage-three recovery hysteresis.")
	patient.adjust_tox_loss(-10)
	pain_state.recalculate()
	TEST_ASSERT_EQUAL(pain_state.stage, 2, "Pain below thirty-five percent must recover promptly to stage two.")
	ADD_TRAIT(patient, TRAIT_ANALGESIA, TRAIT_SOURCE_UNIT_TESTS)
	pain_state.recalculate()
	TEST_ASSERT(pain_state.raw_pain > 0, "Pain immunity must not heal the underlying injury.")
	TEST_ASSERT_EQUAL(pain_state.effective_pain, 0, "Explicit pain immunity must suppress effective pain.")
	TEST_ASSERT_EQUAL(pain_state.stage, 0, "Complete relief must clear symptom stage immediately.")

// Stasis, death and healing clear owned symptoms while preserving unrelated modifiers.
/datum/unit_test/medical_pain/proc/test_lifecycle()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/arm = patient.get_bodypart(BODY_ZONE_R_ARM)
	arm.receive_damage(brute = 40, wound_bonus = CANT_WOUND)
	var/datum/medical_pain/pain_state = patient.medical_pain
	pain_state.recalculate(advance_stage = TRUE, current_time = world.time + 2 SECONDS)
	TEST_ASSERT(patient.has_status_effect(/datum/status_effect/medical_pain), "Pain symptoms must have a patient status.")
	patient.add_or_update_variable_movespeed_modifier(/datum/movespeed_modifier/admin_varedit, multiplicative_slowdown = 0.7)
	ADD_TRAIT(patient, TRAIT_STASIS, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT_EQUAL(pain_state.stage, 0, "Entering stasis must clear symptoms immediately.")
	TEST_ASSERT(!patient.has_status_effect(/datum/status_effect/medical_pain), "Stasis must remove the pain alert.")
	TEST_ASSERT(patient.has_movespeed_modifier(/datum/movespeed_modifier/admin_varedit), "Pain cleanup must preserve unrelated movement modifiers.")
	REMOVE_TRAIT(patient, TRAIT_STASIS, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT_EQUAL(pain_state.effective_pain, 48, "Leaving stasis must restore untreated injury pain.")
	pain_state.recalculate(advance_stage = TRUE, current_time = world.time + 4 SECONDS)
	patient.death()
	TEST_ASSERT_EQUAL(pain_state.stage, 0, "Death must clear pain symptoms immediately.")
	TEST_ASSERT(!patient.has_status_effect(/datum/status_effect/medical_pain), "Death must remove the pain alert.")
	patient.revive()
	TEST_ASSERT_EQUAL(pain_state.effective_pain, 48, "Revival without healing must resample the surviving injury.")
	pain_state.recalculate(advance_stage = TRUE, current_time = world.time + 6 SECONDS)
	patient.fully_heal(ADMIN_HEAL_ALL)
	TEST_ASSERT_EQUAL(pain_state.raw_pain, 0, "Full healing must resample the repaired body.")
	TEST_ASSERT_EQUAL(pain_state.stage, 0, "Full healing must clear pain symptoms.")

// Prosthetic injury is painless and synthetic species retain their original damage slowdown.
/datum/unit_test/medical_pain/proc/test_synthetic_bodies()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/old_arm = patient.get_bodypart(BODY_ZONE_R_ARM)
	old_arm.receive_damage(brute = 40, wound_bonus = CANT_WOUND)
	patient.medical_pain.recalculate(advance_stage = TRUE, current_time = world.time + 2 SECONDS)
	var/obj/item/bodypart/arm/right/robot/prosthesis = allocate(/obj/item/bodypart/arm/right/robot)
	TEST_ASSERT(prosthesis.replace_limb(patient), "The prosthetic fixture must replace the injured arm.")
	qdel(old_arm)
	prosthesis.receive_damage(brute = 40, wound_bonus = CANT_WOUND)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.medical_pain.raw_pain, 0, "Damaged machinery must not cause organic pain.")
	TEST_ASSERT_EQUAL(patient.medical_pain.stage, 0, "Replacing the painful limb must clear symptoms.")
	patient.set_species(/datum/species/android)
	TEST_ASSERT(!patient.uses_medical_pain(), "Androids must opt out of organic pain.")
	patient.adjust_brute_loss(60)
	patient.medical_pain.recalculate(advance_stage = TRUE, current_time = world.time + 4 SECONDS)
	TEST_ASSERT_EQUAL(patient.medical_pain.stage, 0, "Synthetic damage must not escalate pain symptoms.")
	TEST_ASSERT(patient.has_movespeed_modifier(/datum/movespeed_modifier/damage_slowdown), "Synthetic bodies must retain legacy damage impairment.")

// Dynamic fixtures: downstream maxHealth is 135 (HUMAN_HEALTH_MODIFIER), so limb/chest
// damage needed for crit scales with the live mob instead of magic 100-health numbers.
// Chest has body_damage_coeff 1, so chest brute maps 1:1 onto the health deficit.
/datum/unit_test/medical_pain/proc/soft_deficit(mob/living/carbon/human/patient)
	return patient.maxHealth - patient.crit_threshold + 5

/datum/unit_test/medical_pain/proc/hard_deficit(mob/living/carbon/human/patient)
	return patient.maxHealth - patient.hardcrit_threshold + 5

/datum/unit_test/medical_pain/proc/damage_chest_to_softcrit(mob/living/carbon/human/patient)
	patient.get_bodypart(BODY_ZONE_CHEST).receive_damage(brute = soft_deficit(patient), wound_bonus = CANT_WOUND)

/datum/unit_test/medical_pain/proc/damage_chest_to_hardcrit(mob/living/carbon/human/patient)
	patient.get_bodypart(BODY_ZONE_CHEST).receive_damage(brute = hard_deficit(patient), wound_bonus = CANT_WOUND)

// Fill capped organ pain without touching limb health: three severe organs for the full cap.
/datum/unit_test/medical_pain/proc/fill_organs_to_cap(mob/living/carbon/human/patient)
	for(var/organ_slot in list(ORGAN_SLOT_LIVER, ORGAN_SLOT_LUNGS, ORGAN_SLOT_STOMACH))
		var/obj/item/organ/damaged_organ = patient.get_organ_slot(organ_slot)
		patient.set_organ_loss(organ_slot, damaged_organ.high_threshold)

// Fill exactly thirty organ pain without touching limb health: severe liver plus half-severe stomach.
/datum/unit_test/medical_pain/proc/fill_organs_thirty(mob/living/carbon/human/patient)
	var/obj/item/organ/liver = patient.get_organ_slot(ORGAN_SLOT_LIVER)
	patient.set_organ_loss(ORGAN_SLOT_LIVER, liver.high_threshold)
	var/obj/item/organ/stomach = patient.get_organ_slot(ORGAN_SLOT_STOMACH)
	patient.set_organ_loss(ORGAN_SLOT_STOMACH, stomach.high_threshold * 0.5)

/datum/unit_test/medical_pain/proc/organ_pool_damage(mob/living/carbon/human/patient, list/slots)
	var/total = 0
	for(var/slot in slots)
		total += patient.get_organ_loss(slot) || 0
	return total

// Bearable injury below full capacity defers stock crit; pain at capacity restores it from fresh sampling, not visual stage.
/datum/unit_test/medical_pain/proc/test_crit_deferral()
	var/mob/living/carbon/human/soft_patient = allocate(/mob/living/carbon/human/consistent)
	var/soft_want = soft_deficit(soft_patient)
	damage_chest_to_softcrit(soft_patient)
	soft_patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(soft_patient.medical_pain.raw_pain, soft_want * 1.2, "Chest brute must sample with the 1.2 coefficient without wounds.")
	TEST_ASSERT(soft_patient.medical_pain.raw_pain < MEDICAL_PAIN_CAPACITY, "Softcrit fixture must stay below full capacity.")
	TEST_ASSERT(soft_patient.health <= soft_patient.crit_threshold, "Chest fixture must reach softcrit health.")
	TEST_ASSERT(soft_patient.health > soft_patient.hardcrit_threshold, "Chest fixture must stay above hardcrit health.")
	TEST_ASSERT(soft_patient.defers_injury_crit(), "Bearable softcrit pain must defer injury crit.")
	TEST_ASSERT_EQUAL(soft_patient.stat, STABLE, "Bearable softcrit injury must stay STABLE without analgesia.")
	var/mob/living/carbon/human/hard_patient = allocate(/mob/living/carbon/human/consistent)
	var/hard_want = hard_deficit(hard_patient)
	damage_chest_to_hardcrit(hard_patient)
	hard_patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(hard_patient.medical_pain.raw_pain, hard_want * 1.2, "Hardcrit chest brute must sample with the 1.2 coefficient without wounds.")
	TEST_ASSERT(hard_patient.medical_pain.raw_pain >= MEDICAL_PAIN_CAPACITY, "Bare hardcrit fixture must reach full capacity at default balance.")
	TEST_ASSERT(hard_patient.health <= hard_patient.hardcrit_threshold, "Chest fixture must reach hardcrit health.")
	TEST_ASSERT(!hard_patient.defers_injury_crit(), "Untreated hardcrit pain must not defer injury crit.")
	TEST_ASSERT_EQUAL(hard_patient.stat, HARD_CRIT, "Untreated hardcrit injury must stay in stock hardcrit without analgesia.")
	hard_patient.reagents.add_reagent(/datum/reagent/medicine/granibitaluri, 10)
	var/datum/reagent/hard_relief = hard_patient.reagents.has_reagent(/datum/reagent/medicine/granibitaluri)
	hard_relief.compute_metabolization(hard_patient, SSMOBS_DT)
	hard_patient.medical_pain.recalculate()
	TEST_ASSERT(hard_patient.defers_injury_crit(), "Finite mild relief must make hardcrit pain bearable.")
	TEST_ASSERT_EQUAL(hard_patient.stat, STABLE, "Finite mild relief must defer hardcrit injury without healing.")
	hard_patient.reagents.clear_reagents()
	var/mob/living/carbon/human/soft_collapse = allocate(/mob/living/carbon/human/consistent)
	var/soft_base = soft_deficit(soft_collapse)
	damage_chest_to_softcrit(soft_collapse)
	fill_organs_to_cap(soft_collapse)
	soft_collapse.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(soft_collapse.medical_pain.raw_pain, soft_base * 1.2 + MEDICAL_PAIN_ORGAN_CAP, "Chest plus three capped organs must sample scaled limb pain plus the organ cap.")
	TEST_ASSERT(soft_collapse.medical_pain.raw_pain >= MEDICAL_PAIN_CAPACITY, "Softcrit collapse fixture must reach full capacity.")
	TEST_ASSERT(soft_collapse.health <= soft_collapse.crit_threshold, "Collapse soft injury must stay in softcrit health.")
	TEST_ASSERT(!soft_collapse.defers_injury_crit(), "Full-capacity softcrit pain must not defer injury crit.")
	TEST_ASSERT_EQUAL(soft_collapse.stat, SOFT_CRIT, "Full-capacity softcrit injury must restore stock softcrit.")
	var/mob/living/carbon/human/hard_collapse = allocate(/mob/living/carbon/human/consistent)
	var/hard_base = hard_deficit(hard_collapse)
	damage_chest_to_hardcrit(hard_collapse)
	fill_organs_thirty(hard_collapse)
	hard_collapse.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(hard_collapse.medical_pain.raw_pain, hard_base * 1.2 + 30, "Hardcrit chest plus thirty organ pain must sample scaled limb pain plus organs.")
	TEST_ASSERT(hard_collapse.medical_pain.raw_pain >= MEDICAL_PAIN_CAPACITY, "Hardcrit collapse fixture must meet full capacity.")
	TEST_ASSERT(hard_collapse.health <= hard_collapse.hardcrit_threshold, "Collapse injury must stay in hardcrit health.")
	TEST_ASSERT(!hard_collapse.defers_injury_crit(), "Full-capacity hardcrit pain must resume stock crit.")
	TEST_ASSERT_EQUAL(hard_collapse.stat, HARD_CRIT, "Full-capacity hardcrit injury must restore stock hardcrit.")
	soft_patient.medical_pain.stage = 6
	soft_patient.update_stat()
	TEST_ASSERT_EQUAL(soft_patient.stat, STABLE, "Visual stage must not override fresh bearable sampling; the symptom scale still peaks at eighty percent independently.")
	TEST_ASSERT(soft_patient.defers_injury_crit(), "Bearable sampling must defer regardless of visual stage.")
	hard_collapse.medical_pain.stage = 0
	hard_collapse.update_stat()
	TEST_ASSERT_EQUAL(hard_collapse.stat, HARD_CRIT, "Visual recovery must not override fresh collapse sampling.")
	TEST_ASSERT(!hard_collapse.defers_injury_crit(), "Collapse sampling must crit regardless of visual stage.")

// Analgesia and finite medicine restore control without healing, and purging leaves no stale relief.
/datum/unit_test/medical_pain/proc/test_treatment_control()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/patient_want = hard_deficit(patient)
	damage_chest_to_hardcrit(patient)
	fill_organs_thirty(patient)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.medical_pain.raw_pain, patient_want * 1.2 + 30, "Collapse fixture must sample scaled limb pain plus thirty organ pain.")
	TEST_ASSERT(patient.medical_pain.raw_pain >= MEDICAL_PAIN_CAPACITY, "Collapse fixture must start at full capacity.")
	TEST_ASSERT_EQUAL(patient.stat, HARD_CRIT, "Full-capacity injury must start in stock hardcrit.")
	var/starting_brute = patient.get_brute_loss()
	var/starting_health = patient.health
	ADD_TRAIT(patient, TRAIT_ANALGESIA, TRAIT_SOURCE_UNIT_TESTS)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.medical_pain.raw_pain, patient_want * 1.2 + 30, "Trait relief must not heal underlying injury.")
	TEST_ASSERT_EQUAL(patient.medical_pain.effective_pain, 0, "Analgesia trait must suppress effective pain.")
	TEST_ASSERT_EQUAL(patient.get_brute_loss(), starting_brute, "Trait relief must restore control without healing limbs.")
	TEST_ASSERT_EQUAL(patient.health, starting_health, "Trait relief must restore control without healing health.")
	TEST_ASSERT_EQUAL(patient.stat, STABLE, "Trait relief must defer full-capacity hardcrit.")
	REMOVE_TRAIT(patient, TRAIT_ANALGESIA, TRAIT_SOURCE_UNIT_TESTS)
	patient.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(patient.stat, HARD_CRIT, "Removing trait relief must return stock hardcrit without new injury.")
	var/mob/living/carbon/human/soft_treated = allocate(/mob/living/carbon/human/consistent)
	var/soft_want = soft_deficit(soft_treated)
	damage_chest_to_softcrit(soft_treated)
	fill_organs_to_cap(soft_treated)
	soft_treated.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(soft_treated.medical_pain.raw_pain, soft_want * 1.2 + MEDICAL_PAIN_ORGAN_CAP, "Soft collapse fixture must sample scaled limb pain plus the organ cap.")
	TEST_ASSERT(soft_treated.medical_pain.raw_pain >= MEDICAL_PAIN_CAPACITY, "Soft collapse fixture must start at full capacity.")
	TEST_ASSERT_EQUAL(soft_treated.stat, SOFT_CRIT, "Soft collapse fixture must start in stock softcrit.")
	TEST_ASSERT(soft_treated.has_movespeed_modifier(/datum/movespeed_modifier/carbon_softcrit), "Stock softcrit must apply the softcrit movement modifier.")
	ADD_TRAIT(soft_treated, TRAIT_ANALGESIA, TRAIT_SOURCE_UNIT_TESTS)
	soft_treated.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(soft_treated.stat, STABLE, "Pain-only relief must return health crit to STABLE.")
	TEST_ASSERT(!soft_treated.has_movespeed_modifier(/datum/movespeed_modifier/carbon_softcrit), "Pain-only relief must remove the softcrit movement modifier.")
	REMOVE_TRAIT(soft_treated, TRAIT_ANALGESIA, TRAIT_SOURCE_UNIT_TESTS)
	soft_treated.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(soft_treated.stat, SOFT_CRIT, "Purging relief must restore stock softcrit.")
	TEST_ASSERT(soft_treated.has_movespeed_modifier(/datum/movespeed_modifier/carbon_softcrit), "Restored softcrit must restore the softcrit movement modifier.")
	var/mob/living/carbon/human/medicated = allocate(/mob/living/carbon/human/consistent)
	var/medicated_want = hard_deficit(medicated)
	damage_chest_to_hardcrit(medicated)
	fill_organs_thirty(medicated)
	medicated.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(medicated.medical_pain.raw_pain, medicated_want * 1.2 + 30, "Medicated fixture must sample scaled limb pain plus thirty organ pain.")
	TEST_ASSERT(medicated.medical_pain.raw_pain >= MEDICAL_PAIN_CAPACITY, "Medicated fixture must start at full capacity.")
	TEST_ASSERT_EQUAL(medicated.stat, HARD_CRIT, "Medicated fixture must start in stock hardcrit.")
	var/medicated_brute = medicated.get_brute_loss()
	var/medicated_health = medicated.health
	medicated.reagents.add_reagent(/datum/reagent/medicine/morphine, 10)
	var/datum/reagent/morphine = medicated.reagents.has_reagent(/datum/reagent/medicine/morphine)
	morphine.compute_metabolization(medicated, SSMOBS_DT)
	TEST_ASSERT_EQUAL(medicated.get_medical_pain_relief(), MEDICAL_PAIN_RELIEF_STRONG, "Active morphine must provide strong finite relief.")
	medicated.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(medicated.get_brute_loss(), medicated_brute, "Finite medicine must restore control without healing limbs.")
	TEST_ASSERT_EQUAL(medicated.health, medicated_health, "Finite medicine must restore control without healing health.")
	TEST_ASSERT_EQUAL(medicated.stat, STABLE, "Strong finite relief must defer full-capacity hardcrit.")
	medicated.reagents.remove_reagent(/datum/reagent/medicine/morphine, INFINITY)
	medicated.reagents.end_metabolization(medicated, keep_liverless = FALSE)
	medicated.reagents.clear_reagents()
	medicated.medical_pain.recalculate()
	TEST_ASSERT_EQUAL(medicated.get_medical_pain_relief(), 0, "Purging finite medicine must leave no stale relief.")
	TEST_ASSERT_EQUAL(medicated.stat, HARD_CRIT, "Purging finite relief must return stock hardcrit.")

// Physiological-only crit never defers, and death still applies.
/datum/unit_test/medical_pain/proc/test_physiological_guards()
	var/mob/living/carbon/human/oxy_patient = allocate(/mob/living/carbon/human/consistent)
	oxy_patient.adjust_oxy_loss(oxy_patient.maxHealth - oxy_patient.crit_threshold + 1)
	oxy_patient.medical_pain.recalculate()
	TEST_ASSERT(oxy_patient.health <= oxy_patient.crit_threshold, "Oxygen fixture must reach crit health.")
	TEST_ASSERT(!oxy_patient.defers_injury_crit(), "Pure oxygen crit must not defer.")
	TEST_ASSERT_EQUAL(oxy_patient.stat, SOFT_CRIT, "Pure oxygen softcrit must use stock crit.")
	var/mob/living/carbon/human/tox_patient = allocate(/mob/living/carbon/human/consistent)
