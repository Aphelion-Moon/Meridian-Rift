/datum/unit_test/sprite_editor_validation/Run()
	var/datum/sprite_editor_workspace/workspace = allocate(/datum/sprite_editor_workspace, 2, 2, 4)
	var/list/valid = list("type" = "pencil", "layer" = 1, "dir" = "2", "color" = "#ffffffff", "points" = list(list(0, 0)))
	for(var/bad_layer in list(0, 2, 1.5, "1"))
		var/list/transaction = deep_copy_list(valid)
		transaction["layer"] = bad_layer
		TEST_ASSERT(!workspace.can_transact(transaction), "Accepted invalid layer [bad_layer].")
	var/list/transaction = deep_copy_list(valid)
	transaction["dir"] = "3"
	TEST_ASSERT(!workspace.can_transact(transaction), "Accepted an unavailable direction.")
	transaction = deep_copy_list(valid)
	transaction["points"] = list(list(0, 0), list(0, 0), list(0, 0), list(0, 0), list(0, 0))
	TEST_ASSERT(!workspace.can_transact(transaction), "Accepted more points than canvas pixels.")
	for(var/list/bad_point as anything in list(list("0", 0), list(0.5, 0), list(0), list(0, 0, "forged undo")))
		transaction = deep_copy_list(valid)
		transaction["points"] = list(bad_point)
		TEST_ASSERT(!workspace.can_transact(transaction), "Accepted malformed coordinates [json_encode(bad_point)].")
	transaction = deep_copy_list(valid)
	transaction["points"] = list(list(-1, 0), list(0, 0), list(2, 0))
	TEST_ASSERT(!(!workspace.can_transact(transaction) || length(transaction["points"]) != 1), "A stroke crossing the canvas edge must retain only its in-bounds pixels.")
	transaction = list("type" = "bucket", "layer" = 1, "dir" = "2", "color" = "#ffffffff", "point" = list(-1, 0))
	TEST_ASSERT(!workspace.can_transact(transaction), "Accepted an out-of-bounds fill seed.")
	TEST_ASSERT(!workspace.can_transact(list("type" = "flattenLayer", "layer" = 1)), "Accepted flattening the bottom layer.")
	TEST_ASSERT(!workspace.can_transact(list("type" = "deleteLayer", "layer" = 1)), "Accepted deleting the final layer.")

/datum/unit_test/sprite_editor_history/Run()
	var/datum/sprite_editor_workspace/workspace = allocate(/datum/sprite_editor_workspace, 2, 2, 4, "#123456", SPRITE_EDITOR_COLOR_MODE_RGB, SPRITE_EDITOR_ALLOW_UNDO, SPRITE_EDITOR_TOOL_PENCIL)
	var/datum/sprite_editor_workspace/copied = workspace.copy()
	allocated += copied
	TEST_ASSERT(!(copied.backdrop != workspace.backdrop || copied.color_mode != workspace.color_mode || copied.config_flags != workspace.config_flags || copied.tool_flags != workspace.tool_flags), "Copy changed workspace configuration.")
	for(var/x in 0 to 1)
		workspace.new_transaction(list("type" = "pencil", "name" = "Forged history", "layer" = 1, "dir" = "2", "color" = "#ffffffff", "points" = list(list(x, 0))))
	TEST_ASSERT(workspace.undo_names[1] == "Pencil", "History names must be derived on the server.")
	workspace.undo(2)
	TEST_ASSERT(!(length(workspace.undo_stack) || length(workspace.redo_stack) != 2), "Undo did not honor its count.")
	workspace.redo(100)
	TEST_ASSERT(!(length(workspace.undo_stack) != 2 || length(workspace.redo_stack)), "Redo did not clamp its count to the available history.")
	var/list/frame = workspace.get_first_layer_pixel_data()
	TEST_ASSERT(!(frame[1][1] != "#ffffffff" || frame[1][2] != "#ffffffff"), "Redo did not restore both painted pixels.")

/datum/unit_test/custom_sprite_taur_workspace/Run()
	var/datum/sprite_editor_workspace/custom_sprite/workspace = allocate(/datum/sprite_editor_workspace/custom_sprite, null, list("#ff0000"), null, null, 64)
	TEST_ASSERT(!(workspace.width != 64 || workspace.height != 32), "The taur workspace must expose a bounded 64 by 32 canvas.")
	TEST_ASSERT(workspace.new_transaction(list("type" = "pencil", "layer" = 1, "dir" = "2", "color" = "#ff0000ff", "points" = list(list(63, 31)))), "The last pixel of a wide canvas must be paintable.")
	var/list/saved = workspace.serialize_drawing()
	TEST_ASSERT(!(saved?["version"] != 3 || custom_sprite_decode_grid(saved?["dirs"]?["2"], 1, 2048) != "[repeat_string(2047, "0")]1"), "Serialization must preserve the wide canvas's bottom-right pixel.")
	var/datum/sprite_editor_workspace/custom_sprite/reloaded = allocate(/datum/sprite_editor_workspace/custom_sprite, saved, list(), null, null)
	TEST_ASSERT(!(reloaded.width != 64 || reloaded.get_first_layer_pixel_data()[32][64] != "#ff0000ff"), "A saved wide drawing must select its own width when reopened.")
	TEST_ASSERT(workspace.new_transaction(list("type" = "move", "layer" = 1, "dir" = "2", "rect" = list(63, 31, 63, 31), "offset" = list(-1, 0))), "Selection movement must work in the outer half of a wide canvas.")
	workspace.undo()
	TEST_ASSERT(workspace.get_first_layer_pixel_data()[32][64] == "#ff0000ff", "Undo must restore outer canvas paint after a selection move.")
	TEST_ASSERT(!(!workspace.clear_direction("2") || workspace.serialize_drawing()), "Clear must erase the outer half of the wide canvas.")
	workspace.undo()
	TEST_ASSERT(workspace.get_first_layer_pixel_data()[32][64] == "#ff0000ff", "Undo must restore an outer canvas pixel erased by Clear.")
	var/list/legacy = list("version" = 1, "palette" = list("#00ff00"), "dirs" = list("2" = "f1[repeat_string(1023, "0")]"))
	var/datum/sprite_editor_workspace/custom_sprite/centered = allocate(/datum/sprite_editor_workspace/custom_sprite, legacy, list(), null, null, 64)
	TEST_ASSERT(!(centered.get_first_layer_pixel_data()[1][17] != "#00ff00ff" || centered.get_first_layer_pixel_data()[1][1] != "#00000000"), "Opening legacy art on a wide canvas must center it without changing body coordinates.")
	var/before = custom_sprite_hash(workspace.serialize_drawing())
	TEST_ASSERT(workspace.replace_drawing(legacy, null, "Import"), "A legacy import must replace a wide drawing as one history action.")
	TEST_ASSERT(!(workspace.get_first_layer_pixel_data()[1][17] != "#00ff00ff" || workspace.get_first_layer_pixel_data()[32][64] != "#00000000"), "Replacement must center legacy paint and clear old outer canvas pixels.")
	workspace.undo()
	TEST_ASSERT(custom_sprite_hash(workspace.serialize_drawing()) == before, "Undo must exactly restore the wide drawing before a legacy import.")
	workspace.redo()
	TEST_ASSERT(workspace.get_first_layer_pixel_data()[1][17] == "#00ff00ff", "Redo must restore the centered legacy import.")
	var/datum/sprite_editor_workspace/custom_sprite/narrow = allocate(/datum/sprite_editor_workspace/custom_sprite, legacy, list(), null, null)
	var/narrow_before = custom_sprite_hash(narrow.serialize_drawing())
	TEST_ASSERT(!(narrow.replace_drawing(saved, null, "Import") || custom_sprite_hash(narrow.serialize_drawing()) != narrow_before || length(narrow.undo_stack)), "Wide replacement into a narrow workspace must reject without cropping or adding history.")

/datum/unit_test/custom_sprite_workspace/Run()
	var/list/bounds = list("2" = list(10, 10, 20, 20))
	var/datum/sprite_editor_workspace/custom_sprite/workspace = allocate(/datum/sprite_editor_workspace/custom_sprite, null, list("#ffffff"), bounds)
	TEST_ASSERT(!(workspace.can_transact(list("type" = "addLayer")) || workspace.is_valid_color("#ff0000ff") || workspace.is_valid_color("#ffffff80")), "Drawing tools must enforce a single layer and opaque sampled shades.")
