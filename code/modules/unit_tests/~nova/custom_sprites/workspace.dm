	TEST_ASSERT(workspace.new_transaction(list("type" = "move", "layer" = 2, "dir" = "8", "rect" = list(0, 0, 0, 0), "offset" = list(1, 0))), "Generic painting workspaces must accept selection movement.")
	TEST_ASSERT(!(workspace.layers[2]["data"]["8"][1][2] != "#ff000080" || workspace.layers[2]["data"]["8"][1][1] != "#00000000" || workspace.layers[1]["data"]["8"][1][2] != "#00000000" || workspace.layers[2]["data"]["2"][1][2] != "#00000000"), "Move must replace translucent pixels exactly, without blending or changing other layers/directions.")
