// Standalone native regression harness importing the production adapter.
// No client, HTTP request, live world, browser navigation or real timer runs.
#define GLOBAL_VAR_INIT(NAME, VALUE)
#define GAME_VERB_DESC(TYPE, NAME, LABEL, DESCRIPTION, CATEGORY) TYPE/proc/NAME()
#define CONFIG_GET(ENTRY) fixture_config(#ENTRY)
#define CONFIG_ENTRY_HIDDEN 1
#define PROC_REF(NAME) #NAME
#define TYPE_PROC_REF(TYPE, NAME) #NAME
#define INVOKE_ASYNC(OWNER, NAME, ARGS...) fixture_async_calls++
#define DIRECT_OUTPUT(OWNER, VALUE) fixture_outputs++
#define CALLBACK new /datum/callback
#define SECONDS * 10
#define MINUTES * 600
#define TIMER_UNIQUE 1
#define TIMER_OVERRIDE 2
#define RUSTG_HTTP_METHOD_POST "POST"
#define UI_INTERACTIVE 2
#define UI_CLOSE 0
var/global/fixture_outputs = 0
var/global/fixture_timers = 0
var/global/fixture_async_calls = 0
var/global/failures = 0
var/global/assertions = 0
var/global/list/failure_messages = list()
var/global/datum/fixture_globals/GLOB = new
var/global/datum/fixture_tgui/SStgui = new
/proc/fixture_config(entry)
	return findtext(entry, "bridge_url") ? "http://127.0.0.1:18764" : "https://fixture.test/bug-report/"
/proc/GUID()
	return "fixture-id"
/proc/trim(value)
	return trimtext(value)
/proc/qdel(datum/value)
	del(value)
/proc/to_chat(target, value)
/proc/span_notice(value)
	return value
/proc/bug_report_context_snapshot(mob/M, key, session, version, build)
	return list()
/proc/addtimer(datum/callback/callback, delay, flags)
	fixture_timers++
/datum/callback
/datum/config_entry
	var/default
	var/protection
/datum/config_entry/string
/datum/ui_state
/datum/fixture_globals
	var/datum/ui_state/always_state = new
/datum/fixture_tgui/proc/update_uis(datum/source)
/datum/fixture_tgui/proc/try_update_ui(mob/user, datum/source, datum/tgui/ui)
	return null
/datum/tgui/proc/open()
/datum/proc/Destroy()
/datum/proc/ui_data(mob/user)
/datum/proc/ui_state(mob/user)
/datum/proc/ui_status(mob/user)
/datum/proc/ui_interact(mob/user, datum/tgui/ui)
/datum/proc/ui_act(action, list/params, datum/tgui/ui, datum/ui_state/state)
	return FALSE
/datum/http_request/proc/prepare(method, url, body, list/headers, timeout_seconds)
/datum/http_request/proc/begin_async()
/datum/http_request/proc/is_complete()
	return TRUE
/datum/http_request/proc/into_response()
	return new /datum/http_response
/datum/http_response
	var/errored = TRUE
	var/status_code = 503
	var/body
#include "../code/modules/client/bug_reporting.dm"

/datum/bug_report/fixture
	var/list/replies = list()
	var/accept_during_read = FALSE
/datum/bug_report/fixture/New()
	context = list("ckey" = "fixture")
	request_id = "incident"
	session_id = "session"
	registered = TRUE
/datum/bug_report/fixture/valid_owner()
	return TRUE
/datum/bug_report/fixture/register_context()
	return
/datum/bug_report/fixture/bridge_request(route, list/body)
	if(accept_during_read && body?["action"] == "read")
		result = list("kind" = "accepted", "receipt" = list("reportId" = "accepted-during-read"))
	if(!length(replies))
		return null
	var/list/response = replies[1]
	replies.Cut(1, 2)
	return response
/proc/check(condition, message)
	assertions++
	if(!condition)
		failures++
		failure_messages += message
		world.log << "FAIL: [message]"
/proc/fixture_fields(title)
	return list("title" = title, "observed" = "Closed", "expected" = "Open", "reproduction" = "Click", "category" = "Other", "severity" = "minor", "incidentAt" = null)
/proc/fixture_draft(revision, title, list/attachment)
	return list("revision" = revision, "fields" = fixture_fields(title), "attachment" = attachment, "intake" = "draft")
/world/New()
	..()
	var/datum/bug_report/fixture/clean = new
	clean.replies = list(list("draft" = fixture_draft(1, "Browser version")))
	clean.refresh_draft()
	check(clean.fields["title"] == "Browser version", "R8 clean browser revision must hydrate local fields")

	var/datum/bug_report/fixture/conflict = new
	conflict.fields = fixture_fields("Preserved local text")
	conflict.replies = list(list("revisionConflict" = TRUE), list("draft" = fixture_draft(2, "Remote text")))
	conflict.save_fields()
	check(conflict.revision == 0, "R8 conflict must not advance revision behind stale local text")
	check(conflict.fields["title"] == "Preserved local text", "R8 conflict must preserve local text")
	check(hascall(conflict, "resolve_draft"), "R8 conflict requires explicit resolution")
	if(hascall(conflict, "resolve_draft"))
		call(conflict, "resolve_draft")(FALSE)
		check(conflict.fields["title"] == "Remote text" && conflict.revision == 2, "R8 explicit reload adopts matching fields and revision")

	var/datum/bug_report/fixture/poll = new
	poll.result = list("kind" = "checking")
	poll.submission_key = "submission"
	poll.replies = list(null, list("result" = list("kind" = "needs_revision", "feedback" = list("detail"))))
	fixture_timers = 0
	poll.poll_submission()
	check(fixture_timers > 0, "R9 failed submission poll must schedule recovery")
	poll.poll_submission()
	check(poll.result?["kind"] == "needs_revision", "R9 retry must restore actionable feedback")
	poll.result = list("kind" = "checking")
	poll.replies = list(list("result" = list("kind" = "accepted", "receipt" = list("reportId" = "accepted"))))
	poll.refresh_draft()
	check(poll.result?["kind"] == "accepted", "R9 explicit refresh must resume a checking submission")
	poll.replies = list(list("result" = list("kind" = "checking")))
	poll.poll_submission()
	check(poll.result?["kind"] == "accepted", "R9 stale poll must not regress an accepted receipt")
	var/datum/bug_report/fixture/paused = new
	paused.result = list("kind" = "checking")
	paused.submission_key = "submission"
	for(var/i in 1 to 4)
		paused.poll_submission()
	check(paused.polling_paused, "R9 repeated failures must yield a recoverable paused form")
	check(paused.update_local_fields(fixture_fields("Edited after pause"), 0), "R8 paused form permits editing")
	check(!paused.submission_key && !paused.result, "R9 editing a paused draft invalidates the old poll generation")
	check(!paused.update_local_fields(fixture_fields("Stale epoch"), -1), "R8 stale UI epoch must not replace current text")
	paused.result = list("kind" = "accepted")
	check(!paused.update_local_fields(fixture_fields("Immutable"), 0), "R8 accepted fields remain immutable")
	var/datum/bug_report/fixture/dirty = new
	dirty.update_local_fields(fixture_fields("Unsaved local input"), 0)
	dirty.replies = list(list("draft" = fixture_draft(4, "Browser version")))
	dirty.refresh_draft()
	check(dirty.fields["title"] == "Unsaved local input" && dirty.revision == 0 && dirty.remote_draft, "R8 remote refresh preserves dirty local text and requires resolution")
	dirty.resolve_draft(TRUE)
	check(dirty.fields["title"] == "Unsaved local input" && dirty.revision == 4 && dirty.fields_dirty, "R8 explicit keep advances the revision without replacing local input")
	var/list/timed_fields = fixture_fields("Earlier incident")
	timed_fields["incidentAt"] = "2026-10-22T12:34:56.789Z"
	dirty.update_local_fields(timed_fields, dirty.fields_epoch)
	check(dirty.fields["incidentAt"] == "2026-10-22T12:34:56.789Z", "Approved optional incident time crosses native state as exact text")
	var/datum/bug_report/fixture/accepted_during_refresh = new
	accepted_during_refresh.accept_during_read = TRUE
	accepted_during_refresh.replies = list(list("draft" = fixture_draft(3, "Older response")))
	accepted_during_refresh.refresh_draft()
	check(accepted_during_refresh.result?["kind"] == "accepted", "R8 an in-flight draft read cannot regress a concurrently accepted receipt")

	var/datum/bug_report/fixture/fallback = new
	fallback.fields = fixture_fields("Keep offline text")
	fallback.replies = list(null)
	fixture_outputs = 0
	fallback.open_browser("form")
	check(fixture_outputs == 1, "R10 browser fallback must open when save fails")
	check(fallback.fields["title"] == "Keep offline text", "R10 fallback must preserve local text")

	var/datum/bug_report/fixture/capture = new
	capture.replies = list(list("draft" = fixture_draft(1, "Partial report")), list("url" = "https://fixture.test/attachment"), list("draft" = fixture_draft(1, "Partial report")))
	fixture_timers = 0
	capture.open_browser("attachment")
	capture.refresh_draft()
	check(fixture_timers >= 2, "R11 delayed screenshot selection must keep polling after an empty first check")

	world.log << "REPORT_LIFECYCLE_FIXTURE failures=[failures]"
	fdel("bug-report-lifecycle-result.json")
	text2file(json_encode(list("assertions" = assertions, "failures" = failures, "failureMessages" = failure_messages)), "bug-report-lifecycle-result.json")
	shutdown()
