{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meridian:memory:1",
  "title": "Meridian bounded memory observation v1",
  "type": "object",
  "required": ["schema_version", "provenance", "coverage", "quality", "observations", "models", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "provenance": {"type": "object", "required": ["capture_id"], "properties": {"capture_id": {"type": "string", "maxLength": 1024}, "byond": {"type": "string"}, "evidence_class": {"type": "string"}}},
    "coverage": {"type": "object", "required": ["status", "scope"], "properties": {"status": {"enum": ["complete", "partial", "cancelled", "error", "interrupted"]}, "scope": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}}}},
    "quality": {"type": "object"},
    "observations": {"type": "object", "required": ["nodes", "edges"], "properties": {
      "nodes": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/node"}},
      "edges": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/edge"}}
    }},
    "models": {"type": "array"}, "comparison_context": {"type": "object"}, "evidence": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "node": {"type": "object", "required": ["id", "kind", "type", "length", "estimated_bytes"], "properties": {
      "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
      "kind": {"type": "string", "maxLength": 1024}, "type": {"type": "string", "maxLength": 1024},
      "length": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 16777215}, {"type": "null"}]},
      "estimated_bytes": {"type": ["number", "null"], "minimum": 0, "maximum": 900719925474.0991}, "estimate_reason": {"type": "string"}
    }},
    "edge": {"type": "object", "required": ["owner", "target", "field"], "properties": {
      "owner": {"$ref": "#/$defs/count"}, "target": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "field": {"type": "string", "maxLength": 1024}
    }}
  }
}
